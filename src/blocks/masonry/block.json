{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "soli/masonry",
	"version": "0.1.0",
	"title": "Masonry-raster",
	"category": "design",
	"icon": "grid-view",
	"description": "Rangschikt de onderliggende blokken (bijv. een Query Loop) in een responsive masonry-raster, gevuld per kortste kolom.",
	"keywords": [ "masonry", "raster", "kolommen", "layout", "query" ],
	"textdomain": "soli-gutenberg-theme",
	"attributes": {
		"columns": {
			"type": "number",
			"default": 3
		},
		"columnsTablet": {
			"type": "number",
			"default": 2
		},
		"columnsMobile": {
			"type": "number",
			"default": 1
		},
		"gap": {
			"type": "number",
			"default": 24
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"interactivity": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
