{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.2",
	"themes": [
		"."
	],
	"plugins": [],
	"port": 8902,
	"config": {
		"WP_DEBUG": true,
		"WP_DEVELOPMENT_MODE": "theme",
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": true,
		"SCRIPT_DEBUG": true
	},
	"env": {
		"tests": {
			"port": 8903,
			"config": {
				"WP_DEBUG": true,
				"WP_DEVELOPMENT_MODE": "theme",
				"WP_DEBUG_LOG": false,
				"WP_DEBUG_DISPLAY": true,
				"SCRIPT_DEBUG": true
			}
		}
	},
	"mappings": {
		"wp-content/debug.log": "./debug.log"
	},
	"lifecycleScripts": {
		"afterStart": "bash bin/setup.sh"
	}
}
